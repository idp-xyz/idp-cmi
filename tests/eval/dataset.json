  "documents": [
    {
      "ref": "hb-pickup",
      "uri": "handbook://pickup",
      "title": "Pickup slots",
      "text": "Pickup slots. Morning pickup slots run from 07:00 to 11:00; afternoon slots from 13:00 to 17:00. A pickup outside the booked slot costs a 20 EUR surcharge."
    },
    {
      "ref": "hb-returns",
      "uri": "handbook://returns",
      "title": "Returns policy",
      "text": "Returns policy. Returns are accepted within 30 days of delivery. Opened consumables and customised goods are excluded from returns."
    },
    {
      "ref": "hb-customs",
      "uri": "handbook://customs",
      "title": "Customs",
      "text": "Customs. Cross-border parcels need an HS code and a declared value. Duties are prepaid when the sender chooses DDP; otherwise the recipient pays on delivery."
    },
    {
      "ref": "hb-lockers",
      "uri": "handbook://lockers",
      "title": "Lockers",
      "text": "Parcel lockers. Lockers open with the code in the delivery message; a parcel waits in a locker for 72 hours before it is returned to the depot."
    },
    {
      "ref": "hb-damage",
      "uri": "handbook://damage",
      "title": "Damage claims",
      "text": "Damage claims. A damaged parcel is reported within 7 days with photos; the claim is settled at the declared value up to 500 EUR."
    },
    {
      "ref": "hb-returns-zh",
      "uri": "handbook://returns-zh",
      "title": "退货政策",
      "text": "退货政策。签收后 30 天内可以退货；已开封的消耗品和定制商品不接受退货。"
    },
    {
      "ref": "hb-pickup-zh",
      "uri": "handbook://pickup-zh",
      "title": "揽收时段",
      "text": "揽收时段。上午揽收时段为 07:00 至 11:00，下午为 13:00 至 17:00；预约时段之外揽收加收 20 欧元附加费。"
    },
    {
      "ref": "hb-old-pricing",
      "uri": "handbook://pricing",
      "title": "Pricing 2025",
      "text": "Pricing 2025. The handling surcharge is 2 EUR per parcel.",
      "validUntilDaysAgo": 10
    },
    {
      "ref": "hb-pricing",
      "uri": "handbook://pricing-2026",
      "title": "Pricing 2026",
      "text": "Pricing 2026. The handling surcharge is 3 EUR per parcel; bulky parcels pay 6 EUR."
    },
    {
      "ref": "hb-revoked",
      "uri": "handbook://pilot-lockers",
      "title": "Locker pilot",
      "text": "Locker pilot. Pilot lockers keep a parcel for 24 hours only.",
      "revoked": true
    }
  ],
