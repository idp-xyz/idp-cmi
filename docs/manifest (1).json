          description: CMI 操作结果，不代表外部业务执行完成
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Health'
        '400':
          description: 输入不符合契约
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '401':
          description: 身份未验证
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '403':
          description: 访问未授权
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '404':
          description: 资源不存在或为防枚举隐藏
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '409':
          description: 幂等、不可变版本或投影冲突
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '422':
          description: 策略、预算或语义校验失败
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '429':
          description: 请求受限
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '503':
          description: 依赖不可用，受保护数据默认拒绝
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
      security: []
      description: 探针认证及暴露范围由部署策略另行限制；不得泄露敏感配置。
components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      description: 令牌须由受信身份组件校验；生产凭据类型与策略以实际部署为准。
  schemas:
    Scope:
      type: object
      additionalProperties: false
      properties:
        type:
          type: string
          enum:
          - tenant
          - organization
          - team
          - project
          - user
          - business_object
        id: *id001
      required:
      - type
      - id
      description: 归属或请求范围；不是身份，也不自行授予访问权限。
    SourceRef:
      type: object
      additionalProperties: false
      properties:
        source_id: *id001
        source_revision: &id003
          anyOf:
          - &id002
            type: integer
            minimum: 1
          - *id001
          description: 来源版本可以是内部数字修订或上游不透明版本标识；以已审定的接入契约为准。
        locator:
          type:
          - string
          - 'null'
      required:
      - source_id
      - source_revision
      description: 仅为来源版本引用，使用前须验证当前授权与有效性。
    MemoryRef:
      type: object
      additionalProperties: false
      properties:
        memory_id: *id001
        revision: *id002
      required:
      - memory_id
      - revision
    SupportSet:
      type: object
      additionalProperties: false
      properties:
        all_sources:
          type: array
          items:
            $ref: '#/components/schemas/SourceRef'
          minItems: 1
      required:
      - all_sources
      description: 一组对该陈述均属必要的来源。不同支持组只有在被验证为各自独立充分时才构成替代依据。
    SourceIngestRequest:
      type: object
      additionalProperties: false
      properties:
        source_system: *id001
        source_object_key: *id001
        source_revision: *id003
        source_type:
          type: string
          enum:
          - event
          - document
          - conversation
          - api_snapshot
          - human_attestation
        content_location: *id001
        content_hash: *id001
        captured_at: &id005
          type: string
          format: date-time
        client_request_ref: *id001
      required:
      - source_system
      - source_object_key
      - source_revision
      - source_type
      - content_location
      description: 调用方提交的定位和摘要均为待验证输入，不证明对象、权限和内容真实。
    SourceIngestResult:
      type: object
      additionalProperties: false
      properties:
        source_id: *id001
        source_revision: *id003
        status:
          type: string
          enum:
          - pending_verification
          - available
          - restricted
          - revoked
        operation_id: *id001
      required:
      - source_id
      - source_revision
      - status
    MemoryProposalRequest:
      type: object
      additionalProperties: false
      properties:
        scope:
          $ref: '#/components/schemas/Scope'
        subject_ref: *id001
        kind:
          type: string
          enum:
          - working
          - episodic
          - semantic
          - procedural
          - preference
        claim_text: *id001
        language: *id001
        source_refs:
          type: array
          items:
            $ref: '#/components/schemas/SourceRef'
          minItems: 1
        valid_from: &id004
          type:
          - string
          - 'null'
          format: date-time
        valid_to: *id004
        purpose: *id001
      required:
      - scope
      - kind
      - claim_text
      - source_refs
      - purpose
      description: 仅提交候选；不得由调用方自行确权、声明权威、激活或绕过审批。kind 为提案，最终映射待审定。
    MemoryProposalResult:
      type: object
      additionalProperties: false
      properties:
        memory_id: *id001
        revision: *id002
        status:
          type: string
          const: candidate
      required:
      - memory_id
      - revision
      - status
    MemoryRecord:
      type: object
      additionalProperties: false
      properties:
        memory_id: *id001
        tenant_id: *id001
        revision: *id002
        scope:
          $ref: '#/components/schemas/Scope'
        subject_ref:
          type:
          - string
          - 'null'
        kind: *id001
        assertion_kind: *id001
        claim_text: *id001
        language: *id001
        status:
          type: string
          enum: &id006
          - candidate
          - quarantined
          - active
          - disputed
          - superseded
          - expired
          - revoked
        support_sets:
          type: array
          items:
            $ref: '#/components/schemas/SupportSet'
          minItems: 1
        valid_from: *id004
        valid_to: *id004
        recorded_at: *id005
        classification: *id001
        authority_scope:
          type:
          - string
          - 'null'
        confidence:
          type:
          - number
          - 'null'
          minimum: 0
          maximum: 1
      required:
      - memory_id
      - tenant_id
      - revision
      - scope
      - kind
      - assertion_kind
      - claim_text
      - status
      - support_sets
      - recorded_at
      - classification
      description: 目标读模型，不代表历史原型的精简响应；confidence 不等于事实权威性。
    MemorySearchRequest:
      type: object
      additionalProperties: false
      properties:
        query: *id001
        scopes:
          type: array
          items:
            $ref: '#/components/schemas/Scope'
          minItems: 1
          description: 目标多范围查询；范围由服务端授权收窄，不应依赖客户端声明。
        purpose: *id001
        limit: *id002
        as_of_valid: *id004
        known_at: *id004
        required_projection_tickets:
          type: array
          items: *id001
      required:
      - query
      - scopes
      - purpose
    MemorySearchResult:
      type: object
      additionalProperties: false
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/MemoryRecord'
        warnings:
          type: array
          items: *id001
        projection_state:
          type: string
          enum:
          - current
          - pending
          - unknown
      required:
      - items
      - warnings
      description: 返回之前复验权限、版本、来源、状态和时效；结果不得包含无权访问的内容。
    TransitionRequest:
      type: object
      additionalProperties: false
      properties:
        expected_revision: *id002
        target_status:
          type: string
          enum: *id006
        reason_code: *id001
        evidence_refs:
          type: array
          items: *id001
        approval_ref:
          type:
          - string
          - 'null'
      required:
      - expected_revision
      - target_status
      - reason_code
      description: CAS 更新并核验真实审批；approval_ref 非空不构成审批证明。合法转移见主文档。
    TransitionResult:
      type: object
      additionalProperties: false
      properties:
        memory_id: *id001
        revision: *id002
        status:
          type: string
          enum: *id006
      required:
      - memory_id
      - revision
      - status
    TokenBudget:
      type: object
      additionalProperties: false
      properties:
        hard_limit_tokens: *id002
        reserved_system_tokens: &id007
          type: integer
          minimum: 0
        reserved_output_tokens: *id007
        fixed_overhead_tokens: *id007
      required:
      - hard_limit_tokens
      - reserved_system_tokens
      - reserved_output_tokens
      description: 可用预算 = 上限减系统、输出和固定开销；必要信息放不下时显式失败。
    CompileRequest:
      type: object
      additionalProperties: false
      properties:
        task_ref: *id001
        query: *id001
        scopes:
          type: array
          items:
            $ref: '#/components/schemas/Scope'
          minItems: 1
        purpose: *id001
        model_profile_ref: *id001
        budget:
          $ref: '#/components/schemas/TokenBudget'
        as_of_valid: *id004
        known_at: *id004
        required_projection_tickets:
          type: array
          items: *id001
      required:
      - task_ref
      - query
      - scopes
      - purpose
      - model_profile_ref
      - budget
      description: 多范围是目标设计；所核对的历史原型只支持单范围搜索且没有该接口。
    BundleSegment:
      type: object
      additionalProperties: false
      properties:
        segment_id: *id001
        kind: *id001
        content: *id001
        memory_refs:
          type: array
          items:
            $ref: '#/components/schemas/MemoryRef'
        support_sets:
          type: array
          items:
            $ref: '#/components/schemas/SupportSet'
        token_count: *id007
        exact_token_count:
          type: boolean
        requires_live_revalidation:
          type: boolean
      required:
      - segment_id
      - kind
      - content
      - memory_refs
      - support_sets
      - token_count
      - exact_token_count
      - requires_live_revalidation
    ContextBundle:
      type: object
      additionalProperties: false
      properties:
        bundle_id: *id001
        tenant_id: *id001
        principal_ref: *id001
        purpose: *id001
        compiled_at: *id005
        expires_at: *id005
        policy_version: *id001
        model_profile_ref: *id001
        segments:
          type: array
          items:
            $ref: '#/components/schemas/BundleSegment'
        manifest_hash: *id001
        warnings:
          type: array
          items: *id001
      required:
      - bundle_id
      - tenant_id
      - principal_ref
      - purpose
      - compiled_at
      - expires_at
      - policy_version
      - model_profile_ref
      - segments
      - manifest_hash
      - warnings
      description: 仅表示编译输出；清单哈希不证明调用方实际向模型发送了这些内容。
    BundleValidateRequest:
      type: object
      additionalProperties: false
      properties:
        task_ref: *id001
        purpose: *id001
      required:
      - task_ref
      - purpose
    BundleValidateResult:
      type: object
      additionalProperties: false
      properties:
        valid:
          type: boolean
        reason_codes:
          type: array
          items: *id001
        checked_at: *id005
      required:
      - valid
      - reason_codes
      - checked_at
      description: 按当前身份、目的、策略、来源、记忆状态、版本和到期条件复验。
    ErasureRequest:
      type: object
      additionalProperties: false
      properties:
        target_type:
          type: string
          enum:
          - source
          - memory
          - bundle
        target_id: *id001
        reason_code: *id001
        approval_ref:
          type:
          - string
          - 'null'
      required:
      - target_type
      - target_id
      - reason_code
      description: 202 仅表示请求受理；受理、可见性阻断、各域清理、备份处置和验证是不同阶段。
    Operation:
      type: object
      additionalProperties: false
      properties:
        operation_id: *id001
        status:
          type: string
          enum:
          - accepted
          - blocked
          - in_progress
          - partial
          - retryable_failure
          - exception
          - verified
        updated_at: *id005
        warnings:
          type: array
          items: *id001
      required:
      - operation_id
      - status
      - updated_at
      - warnings
    Error:
      type: object
      additionalProperties: false
      properties:
        error:
          type: object
          additionalProperties: false
          properties:
            code: *id001
            message: *id001
            request_id: *id001
            retryable:
              type: boolean
          required:
          - code
          - message
          - request_id
          - retryable
      required:
      - error
    Health:
      type: object
      additionalProperties: false
      properties:
        status: *id001
      required:
      - status
x-cmi-invariants:
- 身份、租户、范围和来源权限由服务端校验，策略不可判断则拒绝受保护数据。
- 授权和时效是硬约束，排序不得抵消；必要来源全部授权，替代来源必须独立充分。
- 归档、撤权、逻辑阻断和物理擦除是不同状态。
- 投影票据为指定写入与代际的凭证，不宣称全局提交序。
- CMI 与 HOST、EER、MCP Infrastructure 无硬依赖；业务实时事实以权威源为准。
