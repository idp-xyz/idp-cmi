openapi: 3.1.0
info:
  title: IDP CMI Proposed Design API
  version: 1.1.0-draft
  description: 目标设计契约草案，与白皮书 V1.0 对齐；未经工程、身份安全及兼容性评审，未发布为生产 API。历史原型可能具有同名路径但请求/响应不同。
servers:
- url: https://cmi.example.invalid
  description: 非真实服务地址
security:
- bearerAuth: []
paths:
  /cmi/v1/sources/ingest:
    post:
      operationId: ingestSource
      summary: 登记并验证来源
      x-cmi-evidence: 历史原型路径存在；字段、权限与生产可用性另需核验
      responses:
        '201':
          description: CMI 操作结果，不代表外部业务执行完成
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SourceIngestResult'
        '202':
          description: 已受理的异步操作
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Operation'
        '400':
          description: 输入不符合契约
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '401':
          description: 身份未验证
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '403':
          description: 访问未授权
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '404':
          description: 资源不存在或为防枚举隐藏
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '409':
          description: 幂等、不可变版本或投影冲突
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '422':
          description: 策略、预算或语义校验失败
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '429':
          description: 请求受限
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '503':
          description: 依赖不可用，受保护数据默认拒绝
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
      parameters:
      - name: Idempotency-Key
        in: header
        required: true
        schema:
          type: string
          minLength: 1
        description: 与服务端可信租户、主体和操作绑定；同键不同请求应冲突。
      requestBody:
        required: true
        content:
