{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idp.example/cmi/v1/memory-record.schema.json",
  "title": "Memory Record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "memory_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "tenant",
            "organization",
            "user",
            "business_object",
            "project",
            "team"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "subject_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "enum": [
        "working",
        "episodic",
        "semantic",
        "procedural",
        "preference"
      ]
    },
    "assertion_kind": {
      "type": "string",
      "enum": [
        "observation",
        "derived_claim",
        "recommendation",
        "approved_policy_reference"
      ]
    },
    "claim_text": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "quarantined",
        "active",
        "disputed",
        "superseded",
        "expired",
        "revoked"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          },
          "source_revision": {
            "type": "integer",
            "minimum": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-fA-F0-9]{64}$"
          },
          "content_span": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "source_id",
          "source_revision"
        ]
      }
    },
    "authority_scope": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "object_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "system",
        "domain",
        "object_type"
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "access_policy_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "retention_policy_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "supersedes_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "contradicted_by_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "relation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "extractor_id": {
      "type": "string",
      "minLength": 1
    },
    "extractor_version": {
      "type": "string",
      "minLength": 1
    },
    "model_profile_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "memory_id",
    "tenant_id",
    "revision",
    "namespace",
    "scope",
    "subject_ref",
    "kind",
    "assertion_kind",
    "claim_text",
    "language",
    "status",
    "source_refs",
    "authority_scope",
    "confidence",
    "confidence_method",
    "valid_from",
    "valid_to",
    "recorded_at",
    "classification",
    "access_policy_ref",
    "retention_policy_ref",
    "supersedes_ref",
    "contradicted_by_refs",
    "relation_refs",
    "extractor_id",
    "extractor_version",
    "model_profile_ref"
  ]
}
