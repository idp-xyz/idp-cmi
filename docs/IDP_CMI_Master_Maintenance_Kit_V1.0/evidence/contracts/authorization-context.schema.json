{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idp.example/cmi/v1/authorization-context.schema.json",
  "title": "Authorization Context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "principal_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "principal_kind": {
      "type": "string",
      "enum": [
        "user",
        "service",
        "delegated_agent"
      ]
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "purpose": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "resource_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "resource_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "resource_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "tenant",
            "organization",
            "user",
            "business_object",
            "project",
            "team"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "delegation_chain": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 256
      }
    },
    "authn_strength": {
      "type": "string",
      "enum": [
        "standard",
        "step_up",
        "workload_verified"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "request_time": {
      "type": "string",
      "format": "date-time"
    },
    "validated_issuer": {
      "type": "string",
      "minLength": 1
    },
    "validated_audience": {
      "type": "string",
      "minLength": 1
    },
    "token_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "principal_id",
    "principal_kind",
    "tenant_id",
    "purpose",
    "action",
    "resource_ref",
    "resource_classification",
    "resource_scope",
    "delegation_chain",
    "authn_strength",
    "policy_version",
    "request_time",
    "validated_issuer",
    "validated_audience",
    "token_fingerprint"
  ]
}
