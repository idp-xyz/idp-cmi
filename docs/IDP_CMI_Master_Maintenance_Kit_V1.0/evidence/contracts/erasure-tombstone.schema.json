{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idp.example/cmi/v1/erasure-tombstone.schema.json",
  "title": "Erasure Tombstone",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "type": "string",
      "enum": [
        "memory",
        "source",
        "bundle"
      ]
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "erasure_operation_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "erased"
    },
    "erased_at": {
      "type": "string",
      "format": "date-time"
    },
    "audit_ref": {
      "type": "string",
      "minLength": 1
    },
    "retention_exception_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "object_type",
    "object_id",
    "erasure_operation_id",
    "status",
    "erased_at",
    "audit_ref",
    "retention_exception_ref"
  ]
}
