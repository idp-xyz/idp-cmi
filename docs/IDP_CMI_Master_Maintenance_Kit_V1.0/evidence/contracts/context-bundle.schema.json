{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idp.example/cmi/v1/context-bundle.schema.json",
  "title": "Context Bundle",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "tenant_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "request_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "subject": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "purpose": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "policy_version": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "compiled_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256
        },
        "tokenizer_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256
        },
        "tokenizer_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "model_id",
        "tokenizer_id",
        "tokenizer_version"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hard_limit_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "reserved_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "selected_tokens_estimated": {
          "type": "integer",
          "minimum": 0
        },
        "exact_count": {
          "type": "boolean"
        },
        "omitted_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "hard_limit_tokens",
        "reserved_output_tokens",
        "selected_tokens_estimated",
        "exact_count",
        "omitted_count"
      ]
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          },
          "segment_kind": {
            "type": "string",
            "enum": [
              "authoritative_fact_reference",
              "source_excerpt",
              "historical_case",
              "approved_policy_reference",
              "procedural_guidance",
              "task_note",
              "warning"
            ]
          },
          "content": {
            "type": "string"
          },
          "token_count_estimated": {
            "type": "integer",
            "minimum": 0
          },
          "assertion_kind": {
            "type": "string",
            "enum": [
              "observation",
              "derived_claim",
              "recommendation",
              "approved_policy_reference"
            ]
          },
          "trust_label": {
            "type": "string",
            "enum": [
              "authoritative_domain",
              "verified_document",
              "internal_observation",
              "user_statement",
              "external_untrusted"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 256
                },
                "source_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^sha256:[a-fA-F0-9]{64}$"
                },
                "content_span": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "source_id",
                "source_revision"
              ]
            }
          },
          "memory_ref": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "memory_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 256
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "memory_id",
              "revision"
            ]
          },
          "requires_live_revalidation": {
            "type": "boolean"
          }
        },
        "required": [
          "segment_id",
          "segment_kind",
          "content",
          "token_count_estimated",
          "assertion_kind",
          "trust_label",
          "source_refs",
          "memory_ref",
          "requires_live_revalidation"
        ]
      }
    },
    "source_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          },
          "source_revision": {
            "type": "integer",
            "minimum": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-fA-F0-9]{64}$"
          },
          "policy_decision_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          }
        },
        "required": [
          "source_id",
          "source_revision",
          "content_hash",
          "policy_decision_id"
        ]
      }
    },
    "projection_watermark": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "ledger_revision": {
      "type": "integer",
      "minimum": 0
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "temporal_mode": {
      "type": "string",
      "enum": [
        "current",
        "historical_bitemporal",
        "valid_as_of",
        "known_as_of"
      ]
    },
    "retrieval_mode": {
      "type": "string",
      "enum": [
        "hybrid",
        "lexical_fallback",
        "exact",
        "graph_hybrid"
      ]
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "tenant_id",
    "request_ref",
    "subject",
    "purpose",
    "policy_version",
    "compiled_at",
    "expires_at",
    "model_profile",
    "budget",
    "segments",
    "source_manifest",
    "projection_watermark",
    "ledger_revision",
    "manifest_hash",
    "warnings",
    "temporal_mode",
    "retrieval_mode",
    "compiler_version"
  ]
}
