  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestRequest": {
        "properties": {
          "source_system": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Source System"
          },
          "source_object_key": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Source Object Key"
          },
          "source_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Source Revision"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "event",
              "document",
              "conversation",
              "api_snapshot",
              "human_attestation"
            ],
            "title": "Source Type"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "title": "Captured At"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Content Hash"
          },
          "content_location": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Content Location"
          },
          "client_request_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Request Ref"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_system",
          "source_object_key",
          "source_revision",
          "source_type",
          "captured_at",
          "content_hash",
          "content_location"
        ],
        "title": "IngestRequest"
      },
      "ProposeRequest": {
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "subject_ref": {
            "type": "string",
            "minLength": 1,
            "title": "Subject Ref"
          },
          "kind": {
            "type": "string",
            "enum": [
              "working",
              "episodic",
              "semantic",
              "procedural",
              "preference"
            ],
            "title": "Kind"
          },
          "claim_text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Claim Text"
          },
          "language": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Language"
          },
          "source_refs": {
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            },
            "type": "array",
            "maxItems": 40,
            "minItems": 1,
            "title": "Source Refs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scope",
          "subject_ref",
          "kind",
          "claim_text",
          "language",
          "source_refs"
        ],
        "title": "ProposeRequest"
      },
      "Scope": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "tenant",
              "organization",
              "user",
              "business_object",
              "project",
              "team"
            ],
            "title": "Type"
          },
          "id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 3,
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "id"
        ],
        "title": "Scope"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Query"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "title": "Purpose"
          },
          "top_k": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 10
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "scope",
          "purpose"
        ],
        "title": "SearchRequest"
      },
      "SourceRef": {
        "properties": {
          "source_id": {
            "type": "string",
            "format": "uuid",
            "title": "Source Id"
          },
          "source_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Source Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "source_revision"
        ],
        "title": "SourceRef"
      },
      "TransitionRequest": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "target_status": {
            "type": "string",
            "enum": [
              "candidate",
              "quarantined",
              "active",
              "disputed",
              "superseded",
              "expired",
              "revoked"
            ],
            "title": "Target Status"
          },
          "reason_code": {
            "type": "string",
            "maxLength": 128,
            "minLength": 3,
            "title": "Reason Code"
          },
          "approval_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Ref"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "target_status",
          "reason_code"
        ],
        "title": "TransitionRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}